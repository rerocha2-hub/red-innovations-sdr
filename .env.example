# ----------------------------------------------------------------------------
# PipeSolo - exemplo de configuração.
# Copie para `.env` e ajuste. O app FUNCIONA sem nenhuma destas variáveis:
# - Sem Stripe: o checkout usa um modo de simulação (stub) e ativa a assinatura.
# - Sem SMTP: os e-mails são impressos no console em vez de enviados.
# ----------------------------------------------------------------------------

# Porta do servidor HTTP
PORT=3000

# URL pública do app (usada em links de e-mail e no retorno do Stripe)
APP_URL=http://localhost:3000

# Segredo de sessão (JWT). Também protege o endpoint de digest. Troque em produção!
JWT_SECRET=troque-este-segredo-em-producao

# Duração do teste grátis, em dias
TRIAL_DAYS=14

# Dias sem atividade até um negócio ser considerado "esfriando" (entra na fila Hoje)
STALE_DAYS=3

# Preço mensal exibido na página de assinatura (apenas exibição)
PLAN_PRICE_LABEL=R$ 29/mês

# --- Stripe (opcional) -------------------------------------------------------
# Se preenchido, o billing usa o Stripe Checkout de verdade.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- SMTP / e-mail (opcional) ------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PipeSolo <no-reply@pipesolo.app>"
